{
    admin off
    auto_https disable_redirects
    default_sni {$TLS_DEFAULT_SNI:localhost}
}

(display) {
    root * /srv
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
    }
    @app_content not path /api/sponsors/* /api/logo
    header @app_content Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'self'"
    @ui path / /display/* /range/* /admin* /*.html /*.js /*.css
    header @ui Cache-Control "no-cache"
    handle /meyton-root.crt {
        root * /data/caddy/pki/authorities/local
        rewrite * /root.crt
        header Content-Type application/x-x509-ca-cert
        header Content-Disposition "attachment; filename=\"meyton-root.crt\""
        file_server
    }
    @public_api {
        path /api/profiles /api/target-rules /api/snapshot /api/events /api/ranges/* /api/sponsors/* /api/logo
        method GET
    }
    handle @public_api {
        reverse_proxy backend:8000 {
            flush_interval -1
        }
    }
    @display_page path /display/* /range/*
    handle @display_page {
        rewrite * /index.html
        file_server
    }
    handle {
        file_server
    }
}

:80 {
    handle /api/admin/* {
        respond "HTTPS required for profile administration" 426
    }
    handle /admin* {
        redir https://{host}:{$HTTPS_PORT:443}{uri} 308
    }
    import display
}

{$DISPLAY_ADDRESS:localhost} {
    tls internal
    handle /api/admin/* {
        reverse_proxy backend:8000 {
            flush_interval -1
        }
    }
    handle /admin* {
        forward_auth backend:8000 {
            uri /api/admin/auth
        }
        rewrite * /admin.html
        file_server
    }
    import display
}

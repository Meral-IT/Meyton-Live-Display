SM_DB_HOST=192.168.10.200
SM_DB_USER=meyton
SM_DB_PASS=
SM_DB_NAME=SSMDB2
SM_DB_PORT=3306

SM_SMB_HOST=192.168.10.200
SM_SMB_USER=meyton
SM_SMB_PASS=
SM_SMB_PORT=445
SM_SMB_SHARE=xml_result
# Alternatively uncomment the local SDF environment and mount in compose.yaml.
# Set this to the absolute host export directory.
# Local SDF files take precedence over SMB; SMB credentials can be left empty.
SM_SDF_DIRECTORY=

SM_TIMEZONE=Europe/Berlin
# Override for SDF wall times. Set empty when XML timestamps represent genuine UTC.
SM_SDF_TIMEZONE=Europe/Berlin
# Live occupancy discovers start-list IDs automatically from SSMDB2.
SM_LANA_HOST=
SM_LANA_PORT=53088
# Complete sessions expire this many days after their last shot. No historical backfill.
SM_RETENTION_DAYS=7
# Used only with compose.demo.yaml: average seconds between shots on each range.
SM_DEMO_SHOT_INTERVAL=3
SM_ADMIN_PASSWORD=
# Comma-separated LAN hostname/IP addresses, also include localhost for local access.
DISPLAY_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443

# Published image channel or version: latest, dev, or a release tag without the leading v.
IMAGE_TAG=latest
